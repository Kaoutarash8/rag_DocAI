# --- Général ---
ENV=production                 # development | production | test
LOG_LEVEL=INFO
CORS_ORIGINS=                  # ex: https://app.exemple.com (vide = désactivé)

# --- Sécurité : comptes et jetons ---
JWT_SECRET=change-me-openssl-rand-hex-32   # obligatoire en production, >= 32 caractères (openssl rand -hex 32)
ACCESS_TOKEN_MINUTES=60
ALLOW_REGISTRATION=true        # false = seuls les admins créent des comptes (POST /admin/users)
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_PER_MINUTE=60       # par utilisateur (Redis) ; 0 = désactivé
AUTH_RATE_LIMIT_PER_MINUTE=10  # login/inscription, par IP et par e-mail ; 0 = désactivé

# --- Exploitation (docker-compose.yml) ---
DOMAIN=localhost               # nom de domaine public pour HTTPS (Let's Encrypt) ; localhost = certificat local
ACME_EMAIL=                    # e-mail pour Let's Encrypt
REDIS_PASSWORD=change-me-hex   # mot de passe Redis : utilisez des caractères hexadécimaux (openssl rand -hex 16)
WORKER_CONCURRENCY=1           # tâches d'ingestion en parallèle PAR conteneur worker
INDEX_VERSION=v2               # suffixe des collections vectorielles (documents_v2) ; v3 = nouvel index à côté de l'ancien
LOG_FORMAT=json                # json (production) | text
METRICS_TOKEN=                 # optionnel : exige « Authorization: Bearer ... » sur /metrics
GRAFANA_PASSWORD=change-me     # profil « monitoring »
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_HOURS=24
BACKUP_INCLUDE_VECTORS=false   # les vecteurs se reconstruisent avec scripts.reindex
# BACKUP_DIR=./backups         # dossier hôte des sauvegardes (idéalement un autre disque)
# QUEUE_BACKEND, REDIS_URL et CHROMA_HOST sont fixés par docker-compose.yml (celery / redis / chroma).

# --- Base de données (utilisé par docker-compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
# En local sans Docker :
# DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag

# --- Fichiers / OCR ---
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=3000
EXTRACT_TABLES=true
OCR_LANG=fra

# --- Indexation ---
CHUNK_SIZE=100                 # profil "baseline" uniquement (les autres profils ont les leurs)
CHUNK_OVERLAP=20
PAGE_BATCH_SIZE=20

# --- Profils de recherche (chunking + embedding + récupération) ---
# Profils fournis : baseline, minilm-250, e5-fixed, bge-fixed, e5-sentence, e5-section, e5-page,
#                   e5-hybrid, e5-hybrid-rerank   (voir app/services/profiles.py)
DEFAULT_PROFILE=baseline
INDEX_PROFILES=baseline        # ex: baseline,e5-fixed,e5-section  |  all   (puis python -m scripts.reindex)
# Surcharge/ajout : RAG_PROFILES_JSON={"prod": {"base": "e5-hybrid-rerank", "top_k": 6, "min_score": 0.78}}
RAG_PROFILES_JSON=

# --- Résumé hiérarchique ---
SUMMARY_BLOCK_WORDS=1500
SUMMARY_MAX_LLM_CALLS=40

# --- Description des figures (VLM) ---
VLM_PROVIDER=none              # none | ollama | openai
VLM_MODEL=qwen2.5vl:7b
VLM_MAX_FIGURES=40
WARMUP_MODELS=true

# --- LLM ---
LLM_PROVIDER=groq              # ollama | groq | openai | mock (tests de charge : aucune requête externe)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
