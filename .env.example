# --- Général ---
ENV=production                 # development | production | test
LOG_LEVEL=INFO
CORS_ORIGINS=                  # ex: https://app.exemple.com (vide = désactivé)

# --- Sécurité ---
API_KEY=change-me-long-random-string   # obligatoire en production
RATE_LIMIT_PER_MINUTE=60

# --- Base de données (utilisé par docker-compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
# En local sans Docker :
# DATABASE_URL=postgresql://rag:change-me@localhost:5432/rag

# --- Fichiers / OCR ---
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
OCR_LANG=fra

# --- Indexation ---
CHUNK_SIZE=100
CHUNK_OVERLAP=20
WARMUP_MODELS=true

# --- LLM ---
LLM_PROVIDER=groq              # ollama | groq | openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
