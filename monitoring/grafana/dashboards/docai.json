{
 "uid": "docai-overview",
 "title": "DocAI — vue d'ensemble",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Latence HTTP p50 / p95 / p99 (/ask)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum by (le) (rate(docai_http_request_duration_seconds_bucket{route=\"/ask\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(docai_http_request_duration_seconds_bucket{route=\"/ask\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(docai_http_request_duration_seconds_bucket{route=\"/ask\"}[5m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requêtes par seconde (par route)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(docai_http_requests_total[5m]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Erreurs HTTP 5xx et 429 (par seconde)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(docai_http_requests_total{status=~\"5..\"}[5m]))",
     "legendFormat": "5xx",
     "refId": "A"
    },
    {
     "expr": "sum(rate(docai_http_requests_total{status=\"429\"}[5m]))",
     "legendFormat": "429 (limite de débit)",
     "refId": "B"
    },
    {
     "expr": "sum by (kind) (rate(docai_errors_total[5m]))",
     "legendFormat": "{{kind}}",
     "refId": "C"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Tokens LLM par minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (kind) (increase(docai_llm_tokens_total[1m]))",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Latence des appels LLM p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(docai_llm_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{provider}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Recherche : p95 par étape",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(docai_retrieval_stage_duration_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Taille de la file d'ingestion",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "docai_queue_length",
     "legendFormat": "en attente (Redis)",
     "refId": "A"
    },
    {
     "expr": "sum by (status) (docai_documents{status=~\"pending|processing\"})",
     "legendFormat": "{{status}} (SQL)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Ingestion : durée p95 et débit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(docai_ingestion_duration_seconds_bucket[15m])))",
     "legendFormat": "p95 (s)",
     "refId": "A"
    },
    {
     "expr": "sum by (status) (rate(docai_ingestion_documents_total[15m])) * 60",
     "legendFormat": "{{status}} / min",
     "refId": "B"
    }
   ]
  }
 ],
 "tags": [
  "docai"
 ]
}